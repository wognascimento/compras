<Window x:Class="Compras.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
        Title="SISTEMA INTEGRADO DE GERENCIAMENTO - COMPRAS"
        Height="350"
        Width="525"
        WindowState="Maximized">

    <Grid x:Name="Etiqueta">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <telerik:RadMenu Grid.Row="0">
            <telerik:RadMenuItem Header="Solicitação">
                <telerik:RadMenuItem Header="Material/Serviço" Click="OnOpenSolicitacao"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Encaminhamento">
                <telerik:RadMenuItem Header="Almoxarifado" Click="OnOpenEncaminhamentoAlmoxarifado"/>
                <telerik:RadMenuItem Header="Material Legado" Click="OnOpenEncaminhamentoMaterialLegado"/>
                <telerik:RadMenuItem Header="Material" Click="OnOpenEncaminhamentoMaterial"/>
                <telerik:RadMenuItem Header="Material Legado Pedido" Click="OnOpenEncaminhamento"/>
                <telerik:RadMenuItem Header="Material Pedido" Click="OnOpenNovoEncaminhamento"/>
                <telerik:RadMenuItem Header="Serviço" Click="OnOpenEncaminhamentoServico"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Pedidos">
                <telerik:RadMenuItem Header="Importar Arquivo" Click="OnImportFile"/>
                <telerik:RadMenuItem Header="Pedidos" Click="OnAbrirPedidos"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Cadastro">
                <telerik:RadMenuItem Header="Fornecedor" Click="OnOpenCadastroFornecedor"/>
                <telerik:RadMenuItem Header="Condição de Pagamento" Click="OnOpenCastroCondicaoPagamento"/>
                <telerik:RadMenuItem Header="Família Comprador(a)" Click="OnOpenCadastroFamiliaComprador"/>
            </telerik:RadMenuItem>

            <telerik:RadMenuItem Header="Consultas">
                <telerik:RadMenuItem Header="Solicitações Finalizadas Legado" Click="OnFinalizadas"/>
                <telerik:RadMenuItem Header="Solicitações Finalizadas Material" Click="OnFinalizadasMaterial"/>
                <telerik:RadMenuItem Header="Gerenciamento" Click="OnOpenConsultaGerencial"/>
                <telerik:RadMenuItem Header="Todas as Descrições" Click="OnOpenTodasDescricoes"/>
            </telerik:RadMenuItem>
            <telerik:RadMenuItem Header="Outros">
                <telerik:RadMenuItem Header="Atualizar Sistema" Click="OnAtualizarSistemaClick"/>
                <telerik:RadMenuItem Header="Sobre" Click="OnSobreSistemaClick"/>
            </telerik:RadMenuItem>
        </telerik:RadMenu>

        <telerik:RadDocking
            x:Name="radDocking"
            Grid.Row="1"
            HasDocumentHost="True">
            <telerik:RadDocking.DocumentHost>
                <telerik:RadSplitContainer>
                    <telerik:RadPaneGroup x:Name="documentGroup"/>
                </telerik:RadSplitContainer>
            </telerik:RadDocking.DocumentHost>
        </telerik:RadDocking>

        <StatusBar Grid.Row="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <StatusBarItem>
                <Image Source="/Icones/icons8-usu_0025c3_0025a1rio-de-g_0025c3_0025aanero-neutro-windows-metro-16.png"
                       Width="16"
                       Height="16"
                       MouseDown="OnAlterarUsuario"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1">
                <TextBlock x:Name="txtUsername"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2">
                <telerik:RadProgressBar x:Name="PbLoading"
                                        Height="20"
                                        Value="80"
                                        Width="100"
                                        IsIndeterminate="True"
                                        Visibility="Hidden"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3">
                <Image Source="/Icones/configuracao-de-dados-windows-metro-16.png"
                       Width="16"
                       Height="16"
                       MouseDown="Image_MouseDown"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="txtDataBase"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
