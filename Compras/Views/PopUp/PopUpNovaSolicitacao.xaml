<UserControl
    x:Class="Compras.Views.PopUp.PopUpNovaSolicitacao"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Compras.Views.PopUp"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    Loaded="OnLoaded"
    d:Padding="5"
    mc:Ignorable="d">

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Tipo" />
            <telerik:RadComboBox x:Name="tipo">
                <ComboBoxItem Content="ALMOXARIFADO" />
                <ComboBoxItem Content="ESTOQUE" />
                <ComboBoxItem Content="SERVIÇO" />
            </telerik:RadComboBox>
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Width="400">
            <TextBlock Text="Fornecedor" />
            <telerik:RadComboBox
                x:Name="cBoxFornecedores"
                DisplayMemberPath="nomefantasia"
                ItemsSource="{Binding Fornecedores}"
                SelectedValuePath="idfornecedor" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="2" >
            <TextBlock Text="Almoxarifado" />
            <telerik:RadWatermarkTextBox x:Name="almoxRecebimento" Text="JACAREÍ" />
        </StackPanel>

        <telerik:RadButton
            x:Name="btnGrevar"
            Grid.Row="2"
            Grid.Column="2"
            Width="75"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="OnClickGravar"
            Content="Gravar"
            IsEnabled="False" />
    </Grid>
</UserControl>
