<UserControl x:Class="Compras.Views.ViewCadastroCondicaoPagamento"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Compras.Views"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <telerik:RadGridView x:Name="condicoes"
                             Grid.Column="0"
                             ItemsSource="{Binding CondicoesPagto}"
                             SelectedItem="{Binding CondicaoPagto}"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             FontSize="10"
                             GroupRenderMode="Flat"
                             NewRowPosition="Top"
                             CanUserInsertRows="True"
                             RowEditEnded="condicoes_RowEditEnded"
                             RowValidating="condicoes_RowValidating"
                             SelectionChanged="condicoes_SelectionChanged">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_cond_pagamento}"
                                            Header="CONDIÇÃO" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding num_parcelas}"
                                            Header="PARCELA"
                                            Width="110" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="PARCELA(S)"
                       HorizontalAlignment="Center"
                       FontSize="15" />

            <telerik:RadGridView x:Name="parcelas"
                                 Grid.Row="1"
                                 ItemsSource="{Binding CondicoesPagtoPrcela}"
                                 AutoGenerateColumns="False"
                                 ShowGroupPanel="False"
                                 FontSize="10"
                                 GroupRenderMode="Flat"
                                 NewRowPosition="Top"
                                 CanUserInsertRows="True"
                                 RowEditEnded="parcelas_RowEditEnded"
                                 RowValidating="parcelas_RowValidating">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding id_parcela}"
                                                Header="ORDEM"
                                                IsReadOnly="True"
                                                Width="90" />
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding numero_dias}"
                                                Header="DIAS"
                                                Width="120" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Grid>

        <GridSplitter Name="gridSplitter"
                      Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      Background="#FFD9D9D9" />
    </Grid>

</UserControl>
