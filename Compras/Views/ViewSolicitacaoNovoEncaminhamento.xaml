<UserControl
    x:Class="Compras.Views.ViewSolicitacaoNovoEncaminhamento"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    Loaded="UserControl_Loaded"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Border Margin="10" BorderBrush="DarkGray" BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colunaSolicitacoes" Width="2*" />
                <ColumnDefinition x:Name="colunaTransferencia" Width="Auto" />
                <ColumnDefinition x:Name="colunaPedido" Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="NOVO ENCAMINHAMENTO DE COMPRAS" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <telerik:RadButton Margin="0,0,8,0" Click="OnAtualizarPendentes" Content="Atualizar Pendentes" />
                    <telerik:RadButton x:Name="btnLimparPedido" Margin="0,0,8,0" Click="OnLimparPedido" Content="Limpar Pedido" />
                    <telerik:RadButton x:Name="btnGerarPedido" Click="OnGerarPedido" Content="Gerar Pedido" />
                </StackPanel>
            </Grid>

            <GroupBox Grid.Row="1" Grid.Column="0" Header="Solicitações Encaminhadas">
                <telerik:RadGridView
                    x:Name="gridPendentes"
                    AutoGenerateColumns="False"
                    CanUserInsertRows="False"
                    GroupRenderMode="Flat"
                    ItemsSource="{Binding SolicitacoesPendentes}"
                    PreviewMouseLeftButtonDown="GridPendentes_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="GridPendentes_PreviewMouseMove"
                    RowEditEnded="GridPendentes_RowEditEnded"
                    SelectionMode="Extended"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.ChildTableDefinitions>
                        <telerik:GridViewTableDefinition>
                            <telerik:GridViewTableDefinition.Relation>
                                <telerik:PropertyRelation ParentPropertyName="Origens" />
                            </telerik:GridViewTableDefinition.Relation>
                        </telerik:GridViewTableDefinition>
                    </telerik:RadGridView.ChildTableDefinitions>

                    <telerik:RadGridView.HierarchyChildTemplate>
                        <DataTemplate>
                            <telerik:RadGridView
                                AutoGenerateColumns="False"
                                CanUserDeleteRows="False"
                                CanUserInsertRows="False"
                                IsFilteringAllowed="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding Origens}"
                                ShowGroupPanel="False">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding cod_solicitacao}" Header="SOLICITAÇÃO" Width="100" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding data_solicitacao}" Header="DATA" DataFormatString="{}{0:dd/MM/yyyy}" Width="95" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding solicitante}" Header="SOLICITANTE" Width="130" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding cliente}" Header="CLIENTE" Width="130" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_solicitacao}" Header="OBSERVAÇÃO" Width="auto" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="QTDE." DataFormatString="{}{0:N2}" Width="85" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="UNID." Width="70" />
                                    <telerik:GridViewDataColumn DataMemberBinding="{Binding data_utilizacao}" Header="UTILIZAÇÃO" DataFormatString="{}{0:dd/MM/yyyy}" Width="100" />
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </DataTemplate>
                    </telerik:RadGridView.HierarchyChildTemplate>

                    <telerik:RadGridView.Columns>
                        <telerik:GridViewCheckBoxColumn
                            DataMemberBinding="{Binding finalizado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EditTriggers="CellClick"
                            Header="Finalizado"
                            IsReadOnly="False"
                            Width="80" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding data_solicitacao}" Header="Data Solic." DataFormatString="{}{0:dd/MM/yyyy}" IsReadOnly="True" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="Descrição" IsReadOnly="True" Width="auto" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="Qtde. Sol." DataFormatString="{}{0:N2}" IsReadOnly="True" Width="90" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade_compra}" Header="Qtde. Compra" DataFormatString="{}{0:N2}" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding saldo_estoque}" Header="Estoque" DataFormatString="{}{0:N2}" IsReadOnly="True" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding preco}" Header="Preço" DataFormatString="{}{0:N2}" Width="85" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="Unid." IsReadOnly="True" Width="65" />
                        <!--<telerik:GridViewDataColumn DataMemberBinding="{Binding nomefantasia}" Header="Fornecedor" IsReadOnly="True" Width="130" />-->
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding data_entrega}" Header="Entrega" DataFormatString="{}{0:dd/MM/yyyy}" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding solicitante}" Header="Solicitante" IsReadOnly="True" Width="110" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding cliente}" Header="Cliente" IsReadOnly="True" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_solicitacao}" Header="Observação Solicitação" IsReadOnly="True" Width="170" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding orientacao_compra}" Header="Orientação Compra" Width="150" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding orientacao_roteiro}" Header="Orientação Roteiro" Width="150" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="Planilha" IsReadOnly="True" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding cod_item}" Header="Item" IsReadOnly="True" Width="70" />
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </GroupBox>

            <StackPanel x:Name="painelTransferencia" Grid.Row="1" Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <telerik:RadButton Margin="0,0,0,8" Click="OnAdicionarSelecionados" Content="&gt;&gt;" Width="60" />
                <telerik:RadButton Click="OnRemoverSelecionados" Content="&lt;&lt;" Width="60" />
            </StackPanel>

            <GroupBox x:Name="grupoMontarPedido" Grid.Row="1" Grid.Column="2" Header="Montar Pedido" AllowDrop="True" Drop="GroupBox_Drop">
                <telerik:RadGridView
                    x:Name="gridPedido"
                    AutoGenerateColumns="False"
                    CanUserInsertRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ItensPedido}"
                    SelectionMode="Extended"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="Planilha" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="Descrição" Width="*" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="Unid." Width="65" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="Qtde." DataFormatString="{}{0:N2}" Width="85" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding preco}" Header="Preço" DataFormatString="{}{0:N2}" Width="85" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding nome_fornecedor}" Header="Fornecedor" Width="130" />
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </GroupBox>

            <TextBlock
                x:Name="textoMontarPedido"
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,8,0,0"
                Foreground="DimGray"
                Text="Arraste ou selecione as solicitações para montar o pedido. Um pedido aceita itens de apenas um fornecedor." />
        </Grid>
    </Border>
</UserControl>
