<UserControl x:Class="Compras.Views.ViewPedidos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Compras.Views"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0.5*" />
        </Grid.ColumnDefinitions>

        <telerik:RadGridView x:Name="pedidos"
                             Grid.Column="0"
                             ItemsSource="{Binding Pedidos}"
                             SelectedItem="{Binding Pedido}"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             FontSize="10"
                             SelectionChanged="pedidos_SelectionChanged">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn DataMemberBinding="{Binding idpedido}" Header="ID" Width="90" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding nomefantasia}" Header="FORNECEDOR" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding abreviacao}" Header="EMPRESA" Width="100" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding datapedido}" Header="DATA PEDIDO" DataFormatString="{}{0:dd/MM/yyyy}" Width="110" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding comprador}" Header="COMPRADOR" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding dataentrega}" Header="ENTREGA" DataFormatString="{}{0:dd/MM/yyyy}" Width="110" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_cond_pagamento}" Header="COND. PAGTO" />
                <telerik:GridViewDataColumn DataMemberBinding="{Binding status}" Header="STATUS" Width="110" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="ITENS DO PEDIDO"
                       HorizontalAlignment="Center"
                       FontSize="15" />

            <telerik:RadGridView x:Name="ItensPedido"
                                 Grid.Row="1"
                                 ItemsSource="{Binding PedidoDets}"
                                 AutoGenerateColumns="False"
                                 ShowGroupPanel="False"
                                 IsFilteringAllowed="True"
                                 FontSize="10">
                <telerik:RadGridView.Columns>
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="PLANILHA" Width="120" />
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="DESCRIÇÃO" />
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="UNID." Width="80" />
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding qtde}" Header="QTDE." DataFormatString="{}{0:N2}" Width="90" />
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding vlrunit}" Header="VALOR." DataFormatString="{}{0:C2}" Width="100" />
                    <telerik:GridViewDataColumn DataMemberBinding="{Binding total}" Header="TOTAL" DataFormatString="{}{0:C2}" Width="100" />
                </telerik:RadGridView.Columns>
            </telerik:RadGridView>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="5"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      Background="#FFD9D9D9" />
    </Grid>
</UserControl>
