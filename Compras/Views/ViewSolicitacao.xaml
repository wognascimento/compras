<UserControl x:Class="Compras.Views.ViewSolicitacao"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="900"
             Loaded="OnLoaded">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <StackPanel>
                <TextBlock Text="ID SOLICITAÇÃO"/>
                <telerik:RadWatermarkTextBox x:Name="IdSolicitacao"
                                             Width="140"
                                             LostFocus="IdSolicitacao_LostFocus"
                                             PreviewKeyDown="IdSolicitacao_PreviewKeyDown"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="TIPO SOLICITAÇÃO"/>
                <telerik:RadWatermarkTextBox x:Name="TipoSolicitacao"
                                             Width="180"
                                             IsReadOnly="True"/>
            </StackPanel>

            <telerik:RadButton x:Name="btnNovo"
                               Content="Novo"
                               Width="90"
                               VerticalAlignment="Bottom"
                               Click="OnCriarSolicitacao"/>

            <telerik:RadButton x:Name="btnEnviar"
                               Content="Enviar"
                               Width="90"
                               VerticalAlignment="Bottom"
                               Click="OnEnviarSolicitacao"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="ID PRODUTO"/>
                    <telerik:RadWatermarkTextBox x:Name="idProduto"
                                                 Width="217"
                                                 PreviewKeyDown="idProduto_PreviewKeyDown"
                                                 LostFocus="idProduto_LostFocus"/>
                </StackPanel>

                <telerik:RadButton x:Name="btnLocalizarProduto"
                                   Content="Pesquisar"
                                   Width="90"
                                   VerticalAlignment="Bottom"
                                   Click="OnListProdutos"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="PLANILHA"/>
                    <telerik:RadComboBox x:Name="txtPlanilha"
                                         Width="260"
                                         IsEditable="True"
                                         OpenDropDownOnFocus="True"
                                         ItemsSource="{Binding Planilhas}"
                                         DisplayMemberPath="planilha"
                                         SelectionChanged="OnSelectedPlanilha"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="DESCRIÇÃO"/>
                    <telerik:RadComboBox x:Name="txtDescricao"
                                         Width="450"
                                         IsEditable="True"
                                         OpenDropDownOnFocus="True"
                                         ItemsSource="{Binding Produtos}"
                                         DisplayMemberPath="descricao"
                                         SelectionChanged="OnSelectedDescricao"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="DESCRIÇÃO ADICIONAL"/>
                    <telerik:RadComboBox x:Name="txtDescricaoAdicional"
                                         Width="260"
                                         IsEditable="True"
                                         OpenDropDownOnFocus="True"
                                         ItemsSource="{Binding DescAdicionais}"
                                         DisplayMemberPath="descricao_adicional"
                                         SelectionChanged="OnSelectedDescricaoAdicional"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="COMPLEMENTO ADICIONAL"/>
                    <telerik:RadComboBox x:Name="txtComplementoAdicional"
                                         Width="450"
                                         IsEditable="True"
                                         OpenDropDownOnFocus="True"
                                         ItemsSource="{Binding CompleAdicionais}"
                                         DisplayMemberPath="complementoadicional"
                                         SelectionChanged="OnSelectedComplementoAdicional"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="UNIDADE"/>
                    <telerik:RadWatermarkTextBox x:Name="unidade"
                                                 Width="90"
                                                 IsReadOnly="True"
                                                 TextAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="QUANTIDADE"/>
                    <telerik:RadWatermarkTextBox x:Name="txtQuantidade"
                                                 Width="110"
                                                 TextAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="DATA UTILIZAÇÃO"/>
                    <telerik:RadDatePicker x:Name="dtSolicitacao"
                                           Width="150"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="PRIORIDADE"/>
                    <telerik:RadComboBox x:Name="cbStatu"
                                         Width="130"
                                         ItemsSource="{Binding Status}"
                                         SelectedItem="{Binding Statu}"
                                         DisplayMemberPath="status"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="SOLICITANTE"/>
                    <telerik:RadWatermarkTextBox x:Name="txtSolicitante"
                                                 Width="370"
                                                 TextAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="SIGLA"/>
                    <telerik:RadComboBox x:Name="txtSigla"
                                         Width="120"
                                         IsEditable="True"
                                         OpenDropDownOnFocus="True"
                                         ItemsSource="{Binding Siglas}"
                                         DisplayMemberPath="sigla_serv"
                                         SelectedItem="{Binding Sigla}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="OBSERVAÇÃO"/>
                <telerik:RadWatermarkTextBox x:Name="txtObservacao"/>
            </StackPanel>

            <GroupBox Header="DSL">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="FASE"/>
                        <telerik:RadComboBox x:Name="cbFase"
                                             Width="250"
                                             IsEditable="True"
                                             OpenDropDownOnFocus="True"
                                             ItemsSource="{Binding Fases}"
                                             DisplayMemberPath="fase"
                                             SelectedItem="{Binding Fase}"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="CLASSIFICAÇÃO"/>
                        <telerik:RadComboBox x:Name="cbClassificacao"
                                             Width="200"
                                             IsEditable="True"
                                             OpenDropDownOnFocus="True"
                                             ItemsSource="{Binding Classificacoes}"
                                             DisplayMemberPath="classificacao"
                                             SelectedItem="{Binding Classificacao}"
                                             SelectionChanged="cbClassificacao_SelectedItemChanged"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="DESCRIÇÃO"/>
                        <telerik:RadComboBox x:Name="cbDescr"
                                             Width="350"
                                             IsEditable="True"
                                             OpenDropDownOnFocus="True"
                                             ItemsSource="{Binding BaseCustos}"
                                             DisplayMemberPath="descr"
                                             SelectedItem="{Binding BaseCusto}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal">
                <telerik:RadButton x:Name="btnAdicionar"
                                   Content="Adicionar"
                                   Width="90"
                                   Click="OnGravarClick"/>
                <telerik:RadButton x:Name="btnAlterar"
                                   Content="Alterar"
                                   Width="90"
                                   Click="OnEditarClick"/>
                <telerik:RadButton x:Name="btnExcluir"
                                   Content="Excluir"
                                   Width="90"
                                   Click="OnExcluirItem"/>
                <telerik:RadButton x:Name="btnApagar"
                                   Content="Limpar"
                                   Width="90"
                                   Click="OnLimparClick"/>
            </StackPanel>
        </StackPanel>

        <telerik:RadGridView x:Name="itensSolicitados"
                             Grid.Row="2"
                             ItemsSource="{Binding ItensSolicitado}"
                             SelectedItem="{Binding ItemSolicitado}"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             IsReadOnly="True"
                             SelectionChanged="OnSelectionChanged"
                             MouseDoubleClick="itensSolicitados_MouseDoubleClick">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="familia" DataMemberBinding="{Binding familia}"/>
                <telerik:GridViewDataColumn Header="planilha" DataMemberBinding="{Binding planilha}"/>
                <telerik:GridViewDataColumn Header="descricao_completa" DataMemberBinding="{Binding descricao_completa}"/>
                <telerik:GridViewDataColumn Header="qtde" DataMemberBinding="{Binding qtde_solicitacao}"/>
                <telerik:GridViewDataColumn Header="unid." DataMemberBinding="{Binding unidade}"/>
                <telerik:GridViewDataColumn Header="cliente" DataMemberBinding="{Binding cliente}"/>
                <telerik:GridViewDataColumn Header="obs." DataMemberBinding="{Binding obs_solicitacao}"/>
                <telerik:GridViewDataColumn Header="utilização" DataMemberBinding="{Binding data_utilizacao}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                <telerik:GridViewDataColumn Header="status" DataMemberBinding="{Binding status}"/>
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>
</UserControl>
