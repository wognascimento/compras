<UserControl
    x:Class="Compras.Views.ViewSolicitacaoEncaminhamento"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    Loaded="UserControl_Loaded"
    d:DesignHeight="600"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Border Margin="10" BorderBrush="DarkGray" BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colunaSolicitacoes" Width="3*" />
                <ColumnDefinition x:Name="colunaTransferencia" Width="Auto" />
                <ColumnDefinition x:Name="colunaPedido" Width="2*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="ENCAMINHAMENTO DE SOLICITAÇÕES" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <telerik:RadButton Margin="0,0,8,0" Click="OnAtualizar" Content="Atualizar" />
                    <telerik:RadButton Margin="0,0,8,0" Click="OnExportarExcel" Content="Enviar para Excel" />
                    <telerik:RadButton x:Name="btnLimparPedido" Margin="0,0,8,0" Click="OnLimparPedido" Content="Limpar Pedido" />
                    <telerik:RadButton x:Name="btnGerarPedido" Click="OnCreateFile" Content="Gerar Pedido" />
                </StackPanel>
            </Grid>

            <GroupBox Grid.Row="1" Grid.Column="0" Header="Solicitações Encaminhadas">
                <telerik:RadGridView
                    x:Name="itensSolicitados"
                    AutoGenerateColumns="False"
                    CanUserInsertRows="False"
                    ItemsSource="{Binding SolicitacoesEncaminhadas}"
                    PreviewMouseLeftButtonDown="ItensSolicitados_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ItensSolicitados_PreviewMouseMove"
                    RowEditEnded="ItensSolicitados_RowEditEnded"
                    SelectedItem="{Binding SolicitacaoEncaminhada}"
                    SelectionMode="Extended"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewCheckBoxColumn
                            DataMemberBinding="{Binding finalizado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            EditTriggers="CellClick"
                            Header="Finalizado"
                            IsReadOnly="False"
                            Width="80" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding data_informado}" Header="Data Solic." DataFormatString="{}{0:dd/MM/yyyy}" IsReadOnly="True" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="Descrição" IsReadOnly="True" Width="auto" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="Qtde." DataFormatString="{}{0:N2}" IsReadOnly="True" Width="80" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="Unid." IsReadOnly="True" Width="65" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding obs_solicitacao}" Header="Observação" IsReadOnly="True" Width="130" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade_compra}" Header="Qtde. Compra" DataFormatString="{}{0:N2}" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding preco}" Header="Preço" DataFormatString="{}{0:N2}" Width="85" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding orientacao_compra}" Header="Orientação Compra" Width="150" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding nomefantasia}" Header="Fornecedor" IsReadOnly="True" Width="130" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding data_entrega}" Header="Entrega" DataFormatString="{}{0:dd/MM/yyyy}" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding solicitante}" Header="Solicitante" IsReadOnly="True" Width="110" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding cliente}" Header="Cliente" IsReadOnly="True" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding data_de_expedicao}" Header="Expedição" DataFormatString="{}{0:dd/MM/yyyy}" IsReadOnly="True" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding familia}" Header="Família" IsReadOnly="True" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding orientacao_roteiro}" Header="Orientação Roteiro" Width="150" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding codcompleadicional}" Header="Cód. Compl." IsReadOnly="True" Width="90" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding saldo_estoque}" Header="Estoque" DataFormatString="{}{0:N2}" IsReadOnly="True" Width="80" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding data_utilizacao}" Header="Utilização" DataFormatString="{}{0:dd/MM/yyyy}" IsReadOnly="True" Width="95" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="Planilha" IsReadOnly="True" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding resp_compra}" Header="Comprador(a)" IsReadOnly="True" Width="110" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding cod_solicitacao}" Header="Solicitação" IsReadOnly="True" Width="85" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding tipo}" Header="Tipo" IsReadOnly="True" Width="80" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding username}" Header="Inserido por" IsReadOnly="True" Width="100" />
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </GroupBox>

            <StackPanel x:Name="painelTransferencia" Grid.Row="1" Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <telerik:RadButton Margin="0,0,0,8" Click="OnAdicionarSelecionados" Content="&gt;&gt;" Width="60" />
                <telerik:RadButton Click="OnRemoverSelecionados" Content="&lt;&lt;" Width="60" />
            </StackPanel>

            <GroupBox x:Name="grupoMontarPedido" Grid.Row="1" Grid.Column="2" Header="Montar Pedido" AllowDrop="True" Drop="ItensPedido_Drop">
                <telerik:RadGridView
                    x:Name="ItensPedido"
                    AutoGenerateColumns="False"
                    CanUserInsertRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding ItensPedido}"
                    SelectionMode="Extended"
                    ShowGroupPanel="False">
                    <telerik:RadGridView.Columns>
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding planilha}" Header="Planilha" Width="100" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding descricao_completa}" Header="Descrição" Width="auto" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding unidade}" Header="Unid." Width="65" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding quantidade}" Header="Qtde." DataFormatString="{}{0:N2}" Width="85" />
                        <telerik:GridViewDataColumn DataMemberBinding="{Binding preco}" Header="Preço" DataFormatString="{}{0:N2}" Width="85" />
                    </telerik:RadGridView.Columns>
                </telerik:RadGridView>
            </GroupBox>

            <TextBlock
                x:Name="textoMontarPedido"
                Grid.Row="2"
                Grid.ColumnSpan="3"
                Margin="0,8,0,0"
                Foreground="DimGray"
                Text="Arraste ou selecione as solicitações para montar um pedido com itens do mesmo fornecedor." />
        </Grid>
    </Border>
</UserControl>
