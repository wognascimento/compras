<UserControl x:Class="Compras.Views.ViewCadastroFornecedor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <telerik:RadWatermarkTextBox x:Name="id"
                                     Grid.Row="0"
                                     Grid.Column="0"
                                     IsReadOnly="True"
                                     WatermarkContent="Código"
                                     Text="{Binding Fornecedor.idfornecedor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadComboBox x:Name="tipo"
                             Grid.Row="0"
                             Grid.Column="1"
                             IsEditable="False"
                             SelectedValue="{Binding Fornecedor.pessoa_j, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectedValuePath="Tag"
                             EmptyText="Tipo">
            <telerik:RadComboBoxItem Content="Física" Tag="Física" />
            <telerik:RadComboBoxItem Content="Jurídica" Tag="Jurídica" />
        </telerik:RadComboBox>

        <telerik:RadWatermarkTextBox x:Name="cnpj"
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     WatermarkContent="CPF/CNPJ"
                                     Text="{Binding Fornecedor.cnpj_cpf, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="OnCnpjLostFocus"
                                     PreviewKeyDown="OnCnpjPreviewKeyDown" />

        <telerik:RadWatermarkTextBox x:Name="razaoSocial"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     WatermarkContent="Razão Social"
                                     Text="{Binding Fornecedor.razao_social, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="apelido"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     WatermarkContent="Apelido"
                                     Text="{Binding Fornecedor.nomefantasia, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="cep"
                                     Grid.Row="2"
                                     Grid.Column="0"
                                     WatermarkContent="CEP"
                                     Text="{Binding Fornecedor.cep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="OnCepKeyDown" />

        <telerik:RadWatermarkTextBox x:Name="endereco"
                                     Grid.Row="3"
                                     Grid.Column="0"
                                     Grid.ColumnSpan="3"
                                     WatermarkContent="Endereço"
                                     Text="{Binding Fornecedor.enderaco, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="numero"
                                     Grid.Row="3"
                                     Grid.Column="3"
                                     WatermarkContent="Número"
                                     Text="{Binding Fornecedor.numero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="bairro"
                                     Grid.Row="4"
                                     Grid.Column="0"
                                     WatermarkContent="Bairro"
                                     Text="{Binding Fornecedor.bairro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="cidade"
                                     Grid.Row="4"
                                     Grid.Column="1"
                                     WatermarkContent="Cidade"
                                     Text="{Binding Fornecedor.cidade, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="estado"
                                     Grid.Row="4"
                                     Grid.Column="2"
                                     WatermarkContent="Estado"
                                     Text="{Binding Fornecedor.estado, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="complemento"
                                     Grid.Row="4"
                                     Grid.Column="3"
                                     WatermarkContent="Complemento"
                                     Text="{Binding Fornecedor.complemento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="site"
                                     Grid.Row="5"
                                     Grid.Column="0"
                                     WatermarkContent="Site"
                                     Text="{Binding Fornecedor.site, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="email"
                                     Grid.Row="5"
                                     Grid.Column="1"
                                     WatermarkContent="E-mail"
                                     Text="{Binding Fornecedor.email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <telerik:RadWatermarkTextBox x:Name="telefone"
                                     Grid.Row="5"
                                     Grid.Column="2"
                                     WatermarkContent="Telefone"
                                     Text="{Binding Fornecedor.fone1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
        
                    Orientation="Horizontal">
            <telerik:RadButton Width="110"
                               Content="Novo"
                               Click="OnBtnNovo" />
            <telerik:RadButton Width="110"
                               Content="Gravar"
                               Click="OnBtnGravar" />
        </StackPanel>

        <telerik:RadGridView x:Name="fornecedoresGrid"
                             Grid.Row="7"
                             Grid.ColumnSpan="4"
                             ItemsSource="{Binding Fornecedores}"
                             SelectedItem="{Binding Fornecedor}"
                             AutoGenerateColumns="False"
                             ShowGroupPanel="False"
                             IsFilteringAllowed="True"
                             SelectionChanged="FornecedoresGrid_SelectionChanged">
            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="ID" DataMemberBinding="{Binding idfornecedor}" Width="90" />
                <telerik:GridViewDataColumn Header="CNPJ/CPF" DataMemberBinding="{Binding cnpj_cpf}" Width="150" />
                <telerik:GridViewDataColumn Header="RAZÃO SOCIAL" DataMemberBinding="{Binding razao_social}" />
                <telerik:GridViewDataColumn Header="APELIDO" DataMemberBinding="{Binding nomefantasia}" Width="170" />
                <telerik:GridViewDataColumn Header="E-MAIL" DataMemberBinding="{Binding email}" Width="180" />
                <telerik:GridViewDataColumn Header="TELEFONE" DataMemberBinding="{Binding fone1}" Width="110" />
            </telerik:RadGridView.Columns>
        </telerik:RadGridView>
    </Grid>

</UserControl>
